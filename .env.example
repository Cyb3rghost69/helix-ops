# HELIX/OPS — variable names only. Never put real values here.
# Copy to ops.env (dashboard login) or ~/.hermes/.env (agents). Both stay local.

# Dashboard login (ops-dashboard/ops.env, mode 0600)
HELIX_OPS_USER=helix
HELIX_OPS_PASSWORD=
# off | 0 | false | open | disabled  → skip login (testing only)
HELIX_OPS_AUTH=
HELIX_OPS_SETUP=

# UniFi Network/Protect (ops-dashboard/unifi.env)
UNIFI_URL=https://192.168.1.1
UNIFI_API_KEY=

# ADZE critic (OpenAI only). Set in ~/.hermes/.env — never Telegram, never frontend.
OPENAI_API_KEY=
ADZE_MODEL=gpt-4o
ADZE_MODE=auto
MAX_DELIBERATION_ROUNDS=3
ALLOW_ADZE_LEAD_FAILOVER=false

# Lead Hermes stays xai-oauth / grok-4.6 on this Mac. Do not put XAI keys in this repo.
# XAI_API_KEY=

# Optional future: RustDesk OSS has no API. Host is configured in code today.
# RUSTDESK_SERVER=192.168.1.84

# RAGNAR SHIELD (LAN exposure audit)
# Local mode (scanner in-process on the Mini): scope + schedule
SHIELD_SCOPE=192.168.1.0/24
SHIELD_INTERVAL_H=6
SHIELD_EXTRA_TARGETS=
# Unraid mode: put these two in ops.env so the deck proxies to the container
# e.g. SHIELD_REMOTE=http://192.168.1.84:8791
SHIELD_REMOTE=
SHIELD_TOKEN=
